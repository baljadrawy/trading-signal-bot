# TSB scheduled jobs (user crontab of the service account). Rendered by ops/host/render.py; install is a
# separate, owner-approved action. Excluded on purpose: the temporary A56 soak monitor and other projects' jobs.
*/30 * * * * ${TSB_HOME}/trading-signal-bot/research/skill_application/.venv/bin/python ${TSB_HOME}/canary_watchdog.py >> ${TSB_HOME}/canary_watchdog.log 2>&1  # CANARY_PHASE_A_WATCHDOG
53 4 * * * ${TSB_HOME}/ops/tsb-p1bg/tsb-p1bg-backup.sh >> ${TSB_HOME}/backups/tsb-p1bg/backup.log 2>&1
17 * * * * cd ${TSB_HOME}/ops/tsb-p2-forward && flock -n .daily.lock sh -c 'for o in 1 2; do D=$(date -u -d "-$o day" +\%F); ls ${TSB_HOME}/research-data/trading-signal-bot/p2/forward-continuous-v1/seals/$D.FAILED-* >/dev/null 2>&1 || nice -n 19 ionice -c3 python3 p2f_seal_day.py ${TSB_HOME}/research-data/trading-signal-bot/p2/forward-continuous-v1 --day $D; nice -n 19 ionice -c3 python3 p2f_backup.py backup ${TSB_HOME}/research-data/trading-signal-bot/p2/forward-continuous-v1 $D && nice -n 19 ionice -c3 python3 p2f_backup.py restore-test ${TSB_HOME}/research-data/trading-signal-bot/p2/forward-continuous-v1 $D; done' >> logs/daily_seal_backup.log 2>&1  # P2F_DAILY_SEAL_BACKUP
