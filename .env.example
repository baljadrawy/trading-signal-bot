# Binance API
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=trading_signals
POSTGRES_USER=trading_bot
POSTGRES_PASSWORD=your_strong_password_here

# Google Drive (للتدريب)
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# إعدادات البوت
PAPER_TRADING=true
MAX_SIGNALS_PER_DAY=5
MIN_SCORE_TO_SIGNAL=7
SCAN_INTERVAL_SECONDS=300
TIMEFRAME=4h

# حجم الصفقة بالـ USDT
# مثال: 50 تعني كل صفقة بـ 50 USDT
TRADE_AMOUNT_USDT=50
RISK_CAPITAL_USDT=500
MAX_DAILY_LOSS_PERCENT=3
MAX_WEEKLY_LOSS_PERCENT=10
MAX_DRAWDOWN_PERCENT=15
MAX_GROSS_EXPOSURE_PERCENT=80
MAX_SYMBOL_EXPOSURE_PERCENT=10
MAX_STRATEGY_EXPOSURE_PERCENT=40
MAX_REGIME_EXPOSURE_PERCENT=50
RISK_CANARY_MAX_OPEN_TRADES=1
MIN_ORDER_NOTIONAL_USDT=5
PRICE_STREAM_ENABLED=true
PRICE_STREAM_REFRESH_SECONDS=5
PRICE_BACKUP_CHECK_SECONDS=30
PRICE_STREAM_ALERT_AFTER_SECONDS=60
STOP_ON_CONSECUTIVE_LOSSES=7
LEARNING_GATES_ENABLED=false

# نظام الموافقة والـ Whitelist
# مدة انتظار موافقتك بالدقائق (افتراضي 30)
APPROVAL_TIMEOUT_MINUTES=30
# أقصى نسبة تغير سعر مقبولة عند الموافقة (افتراضي 0.5%)
APPROVAL_MAX_PRICE_CHANGE_PCT=0.5
